# Copie ce fichier en .env puis lance : python set_session.py
# Ne publie JAMAIS ton .env (il est ignoré par Git).

# --- Connexion WikiMasters (Supabase) ---
SUPABASE_URL=https://cyrxjeppjqsxxjayfrur.supabase.co
# Clé publique "apikey" du site : F12 > Network > une requête vers supabase.co > en-tête "apikey"
# (set_session.py te la demande et la remplit pour toi)
SUPABASE_ANON_KEY=
# Rempli automatiquement par set_session.py (session de ton navigateur)
WIKIMASTERS_REFRESH_TOKEN=

# Facultatif : uniquement informatif (la connexion par mot de passe est bloquée par un captcha)
WIKIMASTERS_EMAIL=
WIKIMASTERS_PASSWORD=

# --- Application ---
FLASK_PORT=5000
FLASK_DEBUG=0
# Mets n'importe quelle longue chaîne aléatoire
SECRET_KEY=change-moi

# Mode démo : données fictives, aucune requête vers WikiMasters (1 = activé)
# Activé automatiquement si aucune session n'est configurée.
# WIKIMASTERS_DEMO=1

# --- Réglages avancés (valeurs par défaut conseillées) ---
# WIKIMASTERS_API_URL=https://www.wiki-masters.com/api
# WIKIMASTERS_EP_OWNED=/my-collection
# WIKIMASTERS_EP_SALES=/marketplace/cards/{card_id}/sales
# WIKIMASTERS_EP_MARKET=/marketplace

# Vitesse / limites du site
# WIKIMASTERS_REQUEST_DELAY=0.3        # pause entre deux requêtes (s)
# WIKIMASTERS_MAX_WORKERS=3            # requêtes en parallèle (collection, marché)
# WIKIMASTERS_SALES_WORKERS=2          # requêtes de prix en parallèle (baisse à 1 si erreurs 403/429)
# WIKIMASTERS_SALES_PAUSE_SECONDS=20   # pause quand le site freine
# WIKIMASTERS_MARKET_MAX_PAGES=40      # pages de 50 enchères lues sur le marché

# Cache des prix
# WIKIMASTERS_SALES_CACHE_HOURS=12     # durée de validité d'un prix de vente
# WIKIMASTERS_MARKET_CACHE_MINUTES=30  # durée de validité du marché

# Calcul des prix
# WIKIMASTERS_SKIP_STARRED=1           # 1 = ne pas chercher le prix des cartes en favoris
# WIKIMASTERS_MAX_ASK_RATIO=3          # ignore une enchère sans offre > 3x les ventes similaires
# WIKIMASTERS_MIN_SALES_SAMPLES=3      # cartes comparables minimum pour une estimation
